<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Shared/MovementHearing.cs" />
    <Compile Include="../../Shared/FootstepAudibility.cs" />
    <ProjectReference Include="../../Server/Comet.Server.csproj" />
    <Compile Include="$(IntermediateOutputPath)Movement.Generated.cs" />
  </ItemGroup>
  <Target Name="PrepareHearing" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/extract.py&quot; &quot;$(IntermediateOutputPath)Movement.Generated.cs&quot;" />
  </Target>
</Project>
