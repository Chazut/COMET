<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Fixture/**/*.cs" />
    <Compile Include="../../Client/EmbeddedFika.cs" Link="EmbeddedFika.cs" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <ProjectReference Include="Fixture/Fixture.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="Fixture/bin/$(Configuration)/netstandard2.1/COMET.OptionalTransportFixture.dll" LogicalName="transport.fixture" />
  </ItemGroup>
</Project>
