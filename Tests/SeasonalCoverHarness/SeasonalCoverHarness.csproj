<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Client/SeasonalCoverAdapter.cs" Link="SeasonalCoverAdapter.cs" />
    <Compile Include="../../Client/CoverExposureAdapter.cs" Link="CoverExposureAdapter.cs" />
    <Compile Include="../../Client/ExposedCoverEscape.cs" Link="ExposedCoverEscape.cs" />
  </ItemGroup>
  <Target Name="ExtractAccess" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/prepare.py&quot;" />
    <ItemGroup>
      <Compile Include="obj/SourceCoverAccess.cs" />
    </ItemGroup>
  </Target>
</Project>
