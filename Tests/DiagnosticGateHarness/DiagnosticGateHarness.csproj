<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Allocation measurements exclude tiered JIT work on the measuring thread. -->
    <TieredCompilation>false</TieredCompilation>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Shared/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Reference
      Include="Microsoft.CodeAnalysis"
      HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll"
    />
    <Reference
      Include="Microsoft.CodeAnalysis.CSharp"
      HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll"
    />
    <Compile Remove="Cases.cs" />
    <None Include="Cases.cs" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
