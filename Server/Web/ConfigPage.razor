@page "/comet"
@using Comet.Core
@using Comet.Server.Editing
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@inject Comet.Server.ConfigStore Store

<PageTitle>COMET settings</PageTitle>
<main class="comet" inert="@(preview != null)">
    <header class="page-heading"><div><span class="eyebrow">COMET / DEVELOPMENT PREVIEW</span><h1>Make the fight your own.</h1>
        <p>Choose a starting level, then tune how PMCs and AI Player Scavs approach combat. Human players, ordinary scavs and bosses are excluded. Your SAIN settings stay unchanged.</p></div>
        <span class="authority">Server settings<br /><strong>Applies next raid</strong></span></header>
    @if (editor == null) { <p role="alert">@message</p><button @onclick="ReadSaved">Try again</button> }
    else {
    <IntegrationStatusPanel Reports="Store.Integration" />
    <PresetLibraryPanel Editor="editor" Preview="OpenPreview" Changed="DraftChanged" />
    <section class="profile-panel" aria-label="COMET difficulty">
        <div class="section-heading"><div><h2>Start with a level</h2><p>Hard keeps the original COMET defaults. Lower levels reduce selected tactical chances and space out attempts.</p></div>
            <span class="pill">In editor: @editor.PresetLabel@(editor.Customized ? " · customized settings" : "")</span></div>
        <div class="profile-cards">
            @foreach (string profile in new[] { "Easy", "Normal", "Hard" }) {
                <button class="profile-card @(editor.Profile == profile ? "chosen" : "")" @onclick="() => PreviewProfile(profile)">
                    <span class="profile-name">@profile <small>@(profile == "Hard" ? "DEFAULT / MAX LEVEL" : "")</small></span>
                    <span>@ProfileText(profile)</span><span class="profile-action">Preview &amp; load →</span>
                </button>
            }
        </div>
        <details class="quiet-details"><summary>What do these levels change?</summary>
            <p>Easy uses 50% and Normal 75% of selected tactical chances, with 50% and 25% longer between attempts. Hard keeps the original values. Features that are off stay off. Aim, hearing, vision and medical settings stay the same.</p>
            <p>Chances apply only when a tactic is eligible. Less aggression can mean more defensive behavior, so every slider is not a difficulty slider. Loading a level replaces all COMET values in the editor; you review it first and save separately.</p>
        </details>
    </section>
    <section class="editor-panel" aria-label="Settings editor">
        <div class="section-heading"><div><h2 tabindex="-1" @ref="editorHeading">Your settings</h2><p>@(advanced ? "All controls, grouped by feature. Open a section to edit it." : "The everyday controls. Switch to Advanced for precise timing, personality weights and safety limits.")</p></div>
            <div class="segmented" role="group" aria-label="Editor detail"><button class="@(!advanced ? "active" : "")" aria-pressed="@(!advanced ? "true" : "false")" @onclick="() => SetMode(false)">Simple</button><button class="@(advanced ? "active" : "")" aria-pressed="@(advanced ? "true" : "false")" @onclick="() => SetMode(true)">Advanced</button></div>
        </div>
        <div class="toolbar">
            <label class="search-label">Find a setting<input type="search" placeholder="Search all settings, even advanced ones…" @bind="search" @bind:event="oninput" /></label>
            <label for="compare-reference">Compare with<select id="compare-reference" aria-label="Compare with" value="@editor.Comparison" @onchange="ChangeComparison"><option>Saved</option><option>Easy</option><option>Normal</option><option>Hard</option></select></label>
            <label class="check-label"><input type="checkbox" @bind="modifiedOnly" /> Modified only</label>
        </div>
        <div class="comparison-line"><span><strong>@editor.DifferenceCount</strong> settings differ from @editor.Comparison.
            @if (editor.ProfileChanged) { <span> Base profile: @editor.ReferenceProfile → @editor.Profile.</span> }</span>
            <span>Comparing does not change your settings.</span></div>
        <details class="quiet-details reading-guide"><summary>How to read these settings</summary>
            <p>Saved is your last saved setup. A default is the supplied value for the named COMET level, before your edits or personal preset. Restore copies the selected comparison value into your draft.</p>
            <p>Chances apply only when the described conditions are met. They are not a percentage of all eligible bots. Weights favor an option without guaranteeing it. Seconds (s), meters (m), percentages (%) and multipliers (x) are shown beside the values.</p>
            <p>For a multiplier, 1 keeps the original amount and 0.5 halves it. For a 0-1 scale, 0.5 means halfway along that scale; it is only a chance when the description says so.</p>
        </details>
        @if (search.Trim().Length > 0) { <p class="notice">Searching all themes and advanced settings. @visible.Count result(s).</p> }
        else if (modifiedOnly && !advanced) { <p class="notice">Modified only includes advanced settings too.</p> }
        <nav class="theme-grid" aria-label="Setting themes">
            <button class="@(category == "All" ? "selected" : "")" @onclick='() => category = "All"'><strong>All themes</strong><span>@visible.Count settings shown</span></button>
            @foreach (var theme in themes) {
                var count = visible.Count(f => editor.Catalog.Sections[f.Section].Category == theme);
                var differences = editor.Catalog.Fields.Values.Count(f => editor.Catalog.Sections[f.Section].Category == theme && editor.Changed(f));
                <button class="@(category == theme ? "selected" : "")" @onclick="() => SelectCategory(theme)"><strong>@theme</strong><span>@count shown · @differences modified</span></button>
            }
        </nav>
        @if (editor.InvalidCount > 0 || editor.ValidationError.Length > 0) {
            <div class="error-banner" role="alert"><strong>Check your draft before saving.</strong>
                @if (editor.InvalidCount > 0) { <p>@editor.InvalidCount invalid field(s). <button @onclick="ShowErrors">Show invalid fields</button></p> }
                @if (editor.ValidationError.Length > 0) { <p>@editor.ValidationError</p> }
            </div>
        }
        @if (shown.Count == 0) {
            <div class="empty"><h3>No matching settings</h3><p>Try another theme, a shorter search or turn off Modified only.</p><button @onclick="ClearFilters">Clear filters</button>
                @if (!advanced) { <button @onclick="() => SetMode(true)">Show advanced settings</button> }
            </div>
        }
        <div class="sections @(!advanced && search.Trim().Length == 0 ? "simple-sections" : "")">
        @foreach (var group in shown.GroupBy(f => f.Section).OrderBy(g => editor.Catalog.Sections[g.Key].Category == "Overview" ? "" : editor.Catalog.Sections[g.Key].Category).ThenBy(g => editor.Catalog.Sections[g.Key].Title)) {
            var section = editor.Catalog.Sections[group.Key];
            var sectionChanges = editor.Catalog.Fields.Values.Count(f => f.Section == group.Key && editor.Changed(f));
            bool expanded = IsExpanded(group.Key);
            <section class="feature" @key="group.Key">
                <button class="feature-heading" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@("section-" + group.Key)" @onclick="() => ToggleSection(group.Key)">
                    <span><small>@section.Category</small><strong>@(advanced ? section.Title : System.Text.RegularExpressions.Regex.Replace(section.Title, @"\s*[-·]\s*[A-Z]\d{2}.*$", ""))</strong></span>
                    <span class="feature-count">@group.Count() settings @(sectionChanges > 0 ? $"· {sectionChanges} modified" : "") <span aria-hidden="true">@(expanded ? "−" : "+")</span></span>
                </button>
                @if (expanded) {
                    <div id="@("section-" + group.Key)" class="feature-body">
                        <p class="feature-description">@section.Summary</p>
                        @if (section.Description != section.Summary) { <details class="quiet-details feature-help"><summary>How it works</summary><p>@section.Description</p></details> }
                        @foreach (var field in group) { <SettingField @key="field.Path" Editor="editor" Field="field" Changed="DraftChanged" /> }
                        <button class="section-restore" disabled="@(sectionChanges == 0 && !group.Any(f => editor.Error(f).Length > 0))" @onclick="() => PreviewSection(group.Key)">Restore this entire section from @editor.Comparison…</button>
                    </div>
                }
            </section>
        }
        </div>
        <details class="quiet-details protections"><summary>Always-on protections &amp; diagnostics</summary>
            @foreach (var note in editor.Catalog.Notes) { <h3>@note.Title</h3><p>@note.Description</p> }
        </details>
    </section>
    <footer class="save-bar"><div><strong>@editor.PendingCount unsaved change(s)@(editor.InvalidCount > 0 ? $" · {editor.InvalidCount} invalid input(s)" : "")</strong>
        <span>Saved revision @editor.Revision · Current raids keep their loaded settings.</span></div>
        <div class="save-actions"><button disabled="@(!editor.HasPending)" @onclick="PreviewDiscard">Discard edits…</button><button class="primary" disabled="@(!editor.CanSave)" @onclick="Save">Save for next raid</button></div>
        @if (message.Length > 0) { <p class="save-message" role="status">@message</p> }
    </footer>
    }
</main>
@if (preview != null && editor != null) {
    <div class="comet dialog-backdrop" @onkeydown="DialogKey">
        <section class="preview-dialog" role="dialog" aria-modal="true" aria-labelledby="preview-title" tabindex="-1" @ref="dialog">
            <span tabindex="0" @onfocus="FocusLast"></span>
            <div class="section-heading"><div><span class="eyebrow">REVIEW BEFORE CHANGING</span><h2 id="preview-title">@preview.Title</h2></div><button aria-label="Close preview" @ref="firstDialogButton" @onclick="ClosePreview">✕</button></div>
            <p>@preview.Changes.Count value(s) will change in your draft. This does not save anything.</p>
            <p>Section restores include advanced settings, even when hidden by your current filters.</p>
            <div class="preview-list"><table><thead><tr><th>Setting</th><th>In editor</th><th>After</th></tr></thead><tbody>
                @foreach (var change in preview.Changes) { <tr><td>@change.Label<small>@change.Path</small></td><td>@change.Before</td><td>@change.After</td></tr> }
            </tbody></table>@if (preview.Changes.Count == 0) { <p>No values need to change.</p> }</div>
            <div class="dialog-actions"><button @onclick="ClosePreview">Cancel</button><button class="primary" @ref="lastDialogButton" @onclick="ApplyPreview">Apply to draft</button></div>
            <span tabindex="0" @onfocus="FocusFirst"></span>
        </section>
    </div>
}

@code {
    ConfigEditor? editor;
    string message = "", search = "", category = "All";
    bool advanced, modifiedOnly;
    readonly HashSet<string> open = new(), closed = new();
    EditorPreview? preview;
    ElementReference dialog, editorHeading, firstDialogButton, lastDialogButton;
    bool focusDialog, focusEditor;
    static readonly string[] themes = { "Overview", "Decisions", "Perception", "Movement", "Doors", "Weapons & lights", "Grenades", "Squad", "Medical", "Recovery", "Diagnostics" };
    List<EditorField> visible => editor!.Visible(advanced, search, modifiedOnly).ToList();
    List<EditorField> shown => visible.Where(f => search.Trim().Length > 0 || category == "All" || editor!.Catalog.Sections[f.Section].Category == category).ToList();
    protected override void OnInitialized() => ReadSaved();
    void ReadSaved() { try { editor = new(Store.Read()); message = ""; } catch (Exception ex) { message = ex.Message; } }
    string ProfileText(string profile) => profile switch { "Easy" => "More breathing room between tactical attempts.", "Normal" => "Less frequent tactical pressure.", _ => "Original chances and timing. The highest supplied level." };
    void SetMode(bool value) { advanced = value; open.Clear(); closed.Clear(); }
    void SelectCategory(string value) { category = value; search = ""; }
    bool IsExpanded(string key) => open.Contains(key) || (!closed.Contains(key) && (!advanced || search.Trim().Length > 0));
    void ToggleSection(string key) { if (IsExpanded(key)) { open.Remove(key); closed.Add(key); } else { closed.Remove(key); open.Add(key); } }
    void ChangeComparison(ChangeEventArgs e) { editor!.Compare(e.Value?.ToString() ?? "Saved"); message = ""; }
    void DraftChanged() => message = "";
    void ClearFilters() { category = "All"; search = ""; modifiedOnly = false; }
    void ShowErrors() { ClearFilters(); advanced = true; foreach (var f in editor!.Catalog.Fields.Values.Where(f => editor.Error(f).Length > 0)) open.Add(f.Section); }
    void PreviewProfile(string name) => OpenPreview(editor!.PreviewProfile(name));
    void PreviewSection(string key) => OpenPreview(editor!.PreviewSection(key));
    void PreviewDiscard() => OpenPreview(editor!.PreviewDiscard());
    void OpenPreview(EditorPreview value) { preview = value; focusDialog = true; }
    void ClosePreview() { preview = null; focusEditor = true; }
    void DialogKey(KeyboardEventArgs e) { if (e.Key == "Escape") ClosePreview(); }
    Task FocusFirst() => firstDialogButton.FocusAsync().AsTask();
    Task FocusLast() => lastDialogButton.FocusAsync().AsTask();
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (focusDialog) { focusDialog = false; await dialog.FocusAsync(); }
        if (focusEditor) { focusEditor = false; await editorHeading.FocusAsync(); }
    }
    void ApplyPreview() { editor!.Apply(preview!); ClosePreview(); message = "Draft updated. Save when ready."; }
    void Save() {
        try { editor!.AcceptSaved(Store.Save(editor.Snapshot(), editor.Revision)); message = "Saved for the next raid. Running raids are unchanged."; }
        catch (Exception e) { message = "Not saved: " + e.Message + " Your draft is still here."; }
    }
}
